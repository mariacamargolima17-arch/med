
/* Variáveis de Ambiente para Temas (Design Tokens) */
.light-theme {
    --bg-color: #f4f4f9;
    --text-color: #1a1a1a;
    --card-bg: #ffffff;
    --primary-color: #4a148c;
    --accent-color: #e91e63;
}

.dark-theme {
    --bg-color: #121212;
    --text-color: #e0e0e0;
    --card-bg: #1e1e1e;
    --primary-color: #bb86fc;
    --accent-color: #ff4081;
}

/* Reset Básico e Acessibilidade Visual */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background-color: var(--bg-color);
    color: var(--text-color);
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    transition: background-color 0.3s, color 0.3s;
    line-height: 1.6;
}

/* Link de Acessibilidade Oculto (Aparece com Focus) */
.skip-link {
    position: absolute;
    top: -40px;
    left: 0;
    background: var(--accent-color);
    color: white;
    padding: 8px;
    z-index: 100;
    transition: top 0.2s;
}
.skip-link:focus { top: 0; }

/* Layout com Flexbox - Header */
.header {
    background-color: var(--card-bg);
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    position: sticky;
    top: 0;
    z-index: 10;
}

.header-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap; /* Garante que quebre linha em telas muito pequenas */
    gap: 15px;
}

.nav-links {
    display: flex;
    list-style: none;
    gap: 20px;
}

.nav-links a {
    color: var(--text-color);
    text-decoration: none;
    font-weight: 600;
}

/* Layout Flexbox - Seção Principal e Projetos */
.hero-section {
    max-width: 800px;
    margin: 60px auto;
    text-align: center;
    padding: 20px;
}

.projects-section {
    max-width: 1200px;
    margin: 40px auto;
    padding: 20px;
}

/* Grid de Projetos usando Flexbox Responsivo */
.projects-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap; /* Flex responsivo sem media queries rígidas */
    gap: 20px;
    margin-top: 20px;
}

.project-card {
    background-color: var(--card-bg);
    padding: 20px;
    border-radius: 8px;
    flex: 1 1 calc(50% - 20px); /* Ocupa metade da linha, subtraindo o gap */
    min-width: 280px; /* Força quebra de linha em telas mobile */
    box-shadow: 0 4px 6px rgba(0,0,0,0.05);
}

/* Componentes de Interação */
.interaction-box {
    margin-top: 30px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
}

button {
    padding: 10px 20px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    font-weight: bold;
    background-color: var(--primary-color);
    color: #fff;
    transition: transform 0.1s;
}

button:active { transform: scale(0.95); }
.footer { text-align: center; padding: 40px; margin-top: 40px; background: var(--card-bg); }
.attribution { font-size: 0.8rem; opacity: 0.7; margin-top: 10px; }
